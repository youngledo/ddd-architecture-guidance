{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huahill/domain-architecture-skills/schemas/domain-architecture-handoff.schema.json",
  "title": "Domain Architecture Handoff",
  "description": "Versioned coordinator-owned handoff for domain modeling, architecture guidance, and optional framework landing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "lineage_id",
    "handoff_id",
    "revision",
    "kind",
    "parent_handoff_id",
    "status",
    "request",
    "scope",
    "producer",
    "phases",
    "decisions",
    "blockers",
    "open_questions",
    "artifacts",
    "planning_readiness",
    "invalidation"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^da-lineage-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^da-handoff-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["interim", "final", "revision"]
    },
    "parent_handoff_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^da-handoff-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "abandoned"]
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "decisions": {
      "$ref": "#/$defs/decisions"
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "planning_readiness": {
      "$ref": "#/$defs/planningReadiness"
    },
    "invalidation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/invalidation"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "revision"
          }
        }
      },
      "then": {
        "properties": {
          "parent_handoff_id": {
            "type": "string",
            "minLength": 1
          },
          "handoff_id": {
            "pattern": "^da-handoff-[A-Za-z0-9][A-Za-z0-9._-]*-r[2-9][0-9]*$"
          },
          "revision": {
            "minimum": 2
          }
        }
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["interim", "final"]
          }
        }
      },
      "then": {
        "properties": {
          "parent_handoff_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "const": "final"
          }
        }
      },
      "then": {
        "properties": {
          "planning_readiness": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "process_companion"],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "process_companion": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_scope", "modeling_depth", "increment_id", "non_goals"],
      "properties": {
        "decision_scope": {
          "type": "string",
          "enum": ["landscape", "bounded-context", "increment"]
        },
        "modeling_depth": {
          "type": "string",
          "enum": ["strategic", "tactical", "both"]
        },
        "increment_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_scope": {
                "const": "increment"
              }
            }
          },
          "then": {
            "required": ["increment_id"],
            "properties": {
              "increment_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "plugin_version", "generated_at"],
      "properties": {
        "skill": {
          "const": "domain-architecture-workflow"
        },
        "plugin_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "status", "result_ref", "affects"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "domain-modeling",
            "architecture-guidance",
            "jfoundry-implementation-guidance"
          ]
        },
        "applicability": {
          "type": "string",
          "enum": ["applicable", "not-applicable", "undecided"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "needs-input", "not-applicable"]
        },
        "result_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "domain-modeling",
              "architecture-guidance",
              "jfoundry-implementation-guidance",
              "planning"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["phase"],
            "properties": {
              "phase": {
                "const": "jfoundry-implementation-guidance"
              }
            }
          },
          "then": {
            "required": ["applicability"]
          }
        },
        {
          "if": {
            "required": ["applicability", "status"],
            "properties": {
              "applicability": {
                "const": "applicable"
              },
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "result_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": ["applicability"],
            "properties": {
              "applicability": {
                "const": "undecided"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "not-applicable"
              },
              "result_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": ["result_ref"]
          }
        }
      ]
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "accepted_assumptions", "constraints"],
      "properties": {
        "confirmed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/confirmedDecision"
          }
        },
        "accepted_assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/acceptedAssumption"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ref", "statement", "original_status", "evidence_refs", "acceptance"],
      "properties": {
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "original_status": {
          "type": "string",
          "enum": ["confirmed", "inferred", "proposed"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        }
      }
    },
    "confirmedDecision": {
      "allOf": [
        {
          "$ref": "#/$defs/decisionBase"
        },
        {
          "properties": {
            "original_status": {
              "const": "confirmed"
            },
            "acceptance": {
              "properties": {
                "status": {
                  "const": "not-required"
                }
              }
            }
          }
        }
      ]
    },
    "acceptedAssumption": {
      "allOf": [
        {
          "$ref": "#/$defs/decisionBase"
        },
        {
          "properties": {
            "original_status": {
              "enum": ["inferred", "proposed"]
            },
            "acceptance": {
              "required": ["source_ref"],
              "properties": {
                "status": {
                  "const": "accepted"
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_ref"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-required", "pending", "accepted"]
        },
        "source_ref": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["not-required", "pending"]
              }
            }
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": ["string", "null"]
              }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "owner_phase",
        "affects",
        "question",
        "resolution_required",
        "status",
        "resolution_ref"
      ],
      "properties": {
        "blocker_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^B-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owner_phase": {
          "type": "string",
          "enum": [
            "domain-modeling",
            "architecture-guidance",
            "jfoundry-implementation-guidance",
            "planning"
          ]
        },
        "affects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "domain-modeling",
              "architecture-guidance",
              "jfoundry-implementation-guidance",
              "planning"
            ]
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "resolution_required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved", "withdrawn"]
        },
        "resolution_ref": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "phase", "kind", "path", "content_digest", "status"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "domain-modeling",
            "architecture-guidance",
            "jfoundry-implementation-guidance",
            "workflow"
          ]
        },
        "kind": {
          "type": "string",
          "enum": ["result", "context-map", "source", "decision-record"]
        },
        "path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "content_digest": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "superseded"]
        },
        "classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "redaction_required": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        {
          "required": ["content_digest"],
          "properties": {
            "content_digest": {
              "type": "string"
            }
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary_artifact_id", "full_artifact_refs", "redaction_policy"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["summary", "full"]
        },
        "summary_artifact_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "full_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "redaction_policy": {
          "type": "string",
          "enum": ["none", "standard", "required"]
        }
      }
    },
    "planningReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "consumed_increment",
        "dependent_blockers",
        "next_owner",
        "recommended_next_step"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ready", "blocked", "deferred"]
        },
        "consumed_increment": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "dependent_blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_owner": {
          "type": "string",
          "enum": ["plugin-managed-planning", "process-companion", "user"]
        },
        "recommended_next_step": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "dependent_blockers": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "required": ["dependent_blockers"],
            "properties": {
              "dependent_blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "invalidates", "reason", "return_to_phase"],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "invalidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "return_to_phase": {
          "type": "string",
          "enum": [
            "domain-modeling",
            "architecture-guidance",
            "jfoundry-implementation-guidance"
          ]
        }
      }
    }
  }
}
